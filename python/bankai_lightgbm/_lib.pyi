class LightGBMError(Exception): ...

class NativeDataset:
    @staticmethod
    def from_dense(
        data: npt.NDArray[np.float64],
        label: list[float],
        params: dict[str, str],
        categorical: list[int],
        weight: list[float] | None = None,
        group: list[int] | None = None,
        reference: NativeDataset | None = None,
        init_score: list[float] | None = None,
        feature_names: list[str] | None = None,
    ) -> NativeDataset: ...
    @staticmethod
    def from_sparse(
        indptr: npt.NDArray[np.int64],
        indices: npt.NDArray[np.int32],
        data: npt.NDArray[np.float64],
        nrow: int,
        ncol: int,
        is_csc: bool,
        label: list[float],
        params: dict[str, str],
        categorical: list[int],
        weight: list[float] | None = None,
        group: list[int] | None = None,
        reference: NativeDataset | None = None,
        init_score: list[float] | None = None,
        feature_names: list[str] | None = None,
    ) -> NativeDataset: ...
    def with_init_score(self, init_score: list[float]) -> NativeDataset: ...
    def with_fields(
        self,
        label: list[float] | None = None,
        weight: list[float] | None = None,
        group: list[int] | None = None,
    ) -> NativeDataset: ...
    def num_data(self) -> int: ...
    def num_feature(self) -> int: ...
    def feature_num_bin(self, feature: int) -> int: ...
    def dump_text(self, path: str) -> None: ...
    def label(self) -> npt.NDArray[np.float32]: ...
    def weight(self) -> npt.NDArray[np.float32] | None: ...
    def save_binary(self, path: str) -> None: ...
    def subset(self, indices: list[int]) -> NativeDataset: ...

class NativeBooster:
    @staticmethod
    def train(
        params: dict[str, str],
        dataset: NativeDataset,
        init_model: NativeBooster | None = None,
        warn_config: bool = True,
    ) -> NativeBooster: ...
    @staticmethod
    def create_training(
        params: dict[str, str], dataset: NativeDataset, init_model: NativeBooster | None = None
    ) -> NativeBooster: ...
    @staticmethod
    def refit(
        params: dict[str, str],
        dataset: NativeDataset,
        source: NativeBooster,
        leaf_pred: list[int],
        ncol: int,
    ) -> NativeBooster: ...
    def update(self) -> bool: ...
    def rollback_one_iter(self) -> None: ...
    def set_leaf_output(self, tree_idx: int, leaf_idx: int, value: float) -> None: ...
    def shuffle_models(self, start: int, end: int) -> None: ...
    def reset_custom_objective(self) -> None: ...
    def training_score(self) -> npt.NDArray[np.float64]: ...
    def update_custom(self, gradients: list[float], hessians: list[float]) -> bool: ...
    def reset_learning_rate(self, learning_rate: float) -> None: ...
    def eval(
        self, dataset: NativeDataset, params: dict[str, str], data_name: str
    ) -> list[tuple[str, str, float, bool]]: ...
    @staticmethod
    def from_file(path: str) -> NativeBooster: ...
    @staticmethod
    def from_string(model_str: str) -> NativeBooster: ...
    def num_class(self) -> int: ...
    def num_tree_per_iteration(self) -> int: ...
    def num_trees(self) -> int: ...
    def current_iteration(self) -> int: ...
    def num_feature(self) -> int: ...
    def feature_names(self) -> list[str]: ...
    def pandas_categorical(self) -> str | None: ...
    def objective(self) -> str | None: ...
    def save_model_to_string(
        self, start_iteration: int, num_iteration: int, importance_type: int
    ) -> str: ...
    def dump_model(self, start_iteration: int, num_iteration: int, importance_type: int) -> str: ...
    def feature_importance(self, num_iteration: int, importance_type: int) -> list[float]: ...
    def upper_bound(self) -> float: ...
    def lower_bound(self) -> float: ...
    def leaf_value(self, tree_idx: int, leaf_idx: int) -> float: ...
    def predict_dense(
        self,
        data: npt.NDArray[np.float64],
        kind: int,
        start_iteration: int,
        num_iteration: int,
        pred_early_stop: bool = ...,
        pred_early_stop_freq: int = ...,
        pred_early_stop_margin: float = ...,
        num_threads: int = ...,
        disable_shape_check: bool = ...,
    ) -> npt.NDArray[Any]: ...
    def predict_sparse(
        self,
        indptr: npt.NDArray[np.int64],
        indices: npt.NDArray[np.int32],
        data: npt.NDArray[np.float64],
        nrow: int,
        ncol: int,
        is_csc: bool,
        kind: int,
        start_iteration: int,
        num_iteration: int,
        pred_early_stop: bool = ...,
        pred_early_stop_freq: int = ...,
        pred_early_stop_margin: float = ...,
        num_threads: int = ...,
        disable_shape_check: bool = ...,
    ) -> Any: ...

