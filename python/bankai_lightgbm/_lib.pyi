from typing import Any

import numpy as np
import numpy.typing as npt

UPSTREAM_VERSION: str
__version__: str

class LightGBMError(Exception): ...

class NativeBooster:
    @staticmethod
    def from_file(path: str) -> NativeBooster: ...
    @staticmethod
    def from_string(model_str: str) -> NativeBooster: ...
    def num_class(self) -> int: ...
    def num_tree_per_iteration(self) -> int: ...
    def num_trees(self) -> int: ...
    def current_iteration(self) -> int: ...
    def num_feature(self) -> int: ...
    def feature_names(self) -> list[str]: ...
    def pandas_categorical(self) -> str | None: ...
    def objective(self) -> str | None: ...
    def predict_dense(
        self,
        data: npt.NDArray[np.float64],
        kind: int,
        start_iteration: int,
        num_iteration: int,
        pred_early_stop: bool = ...,
        pred_early_stop_freq: int = ...,
        pred_early_stop_margin: float = ...,
        num_threads: int = ...,
        disable_shape_check: bool = ...,
    ) -> npt.NDArray[Any]: ...
